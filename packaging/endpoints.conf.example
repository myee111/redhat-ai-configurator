# redhat-ai-configurator service endpoints
#
# Copy this file to /etc/redhat-ai-configurator/endpoints.conf and edit it, or
# set the same variables in the environment. Environment variables win.
#
# Only the base URL of each provider you configure is mandatory:
#   RHAI_MAAS_BASE_URL   if you configure rhai-maas
#   ENMAAS_BASE_URL      if you configure enmaas
# Everything else only changes what the UI shows. Omitted or blank values fall
# back to the defaults below; a blank base URL does not disable a provider.
#
# RHAI_MAAS_BASE_URL is the OpenAI-compatible root and must include /v1.
# ENMAAS_BASE_URL is the Anthropic-compatible root and must NOT include /v1;
# goose appends v1/messages to it.

# --- Mandatory (for the provider you configure) ---------------------------------

RHAI_MAAS_BASE_URL=https://maas.example.com/v1
ENMAAS_BASE_URL=https://enmaas.example.com

# --- Recommended (dead links are shown if these stay at example.com) ------------

RHAI_MAAS_KEY_PAGE=https://maas.example.com/keys
RHAI_MAAS_HELP_URL=https://maas.example.com/docs

ENMAAS_KEY_PAGE=https://enmaas.example.com/keys
ENMAAS_HELP_URL=https://enmaas.example.com/docs

# --- Optional (hidden when unset) ------------------------------------------------

# ENMAAS_ELIGIBILITY_URL=https://enmaas.example.com/access
# ENMAAS_SLACK=#help
